#!/bin/sh

[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = nradio,wt9106 ] || exit 1
case "$1" in wwan*) index=${1#wwan} ;; *) exit 1 ;; esac
case "$index" in ''|*[!0-9]*) exit 1 ;; esac

device=$(readlink -f "/sys/class/net/$1/device") || exit 1
[ "$(basename "$(readlink -f "$device/driver")")" = qmi_wwan ] || exit 1
usb=${device%/*}
[ "$(cat "$usb/idVendor" 2>/dev/null):$(cat "$usb/idProduct" 2>/dev/null)" = 2c7c:0801 ] || exit 1
[ "$(cat "$usb/product" 2>/dev/null)" = RG520N-EB ] || exit 1

format="/sys/class/net/$1/qmi/raw_ip"
exec 9>"/var/lock/swrt-qmi-$1.lock"
flock -x 9 || exit 1
case "$(cat "$format" 2>/dev/null)" in
	Y) exit 0 ;;
	N) ;;
	*) exit 1 ;;
esac

flags=$(cat "/sys/class/net/$1/flags") || exit 1
if [ "$((flags & 1))" -eq 0 ]; then
	printf 'Y\n' > "$format"
else
	ip link set dev "$1" down || exit 1
	printf 'Y\n' > "$format"
	result=$?
	ip link set dev "$1" up && [ "$result" -eq 0 ]
fi
