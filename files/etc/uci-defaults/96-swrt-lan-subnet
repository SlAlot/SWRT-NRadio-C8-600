#!/bin/sh

. /lib/functions.sh

[ "$(board_name)" = nradio,wt9106 ] || exit 0
[ "$(uci -q get network.lan.proto)" = static ] || exit 0
[ "$(uci -q get network.lan.device)" = br-lan ] || exit 0
[ "$(uci -q get network.lan.ipaddr)" = 192.168.17.1 ] || exit 0
[ -z "$(uci -q get network.lan.netmask)" ] || exit 0

# 1.1.5 replaced the generated CIDR address with a bare IPv4 address.
uci set network.lan.ipaddr='192.168.17.1/24' && uci commit network
