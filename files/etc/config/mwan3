config globals 'globals'
	option mmx_mask '0x3F0000'

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option track_method 'ping'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '4'

config member 'wired'
	option interface 'wan'
	option metric '3'
	option weight '1'

config policy 'swrt_failover'
	list use_member 'wired'
	option last_resort 'default'

config rule 'default_v4'
	option family 'ipv4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'swrt_failover'
