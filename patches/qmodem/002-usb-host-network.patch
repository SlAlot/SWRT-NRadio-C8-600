+    size_t dns4 = le32toh(info->IPv4DnsServerCount) >= 2 ? 8 : 4;
+    size_t dns6 = le32toh(info->IPv6DnsServerCount) >= 2 ? 32 : 16;
+
+    return (!(v4 & 1) || mbim_ip_field_fits(info->IPv4AddressOffset, length, sizeof(MBIM_IPV4_ELEMENT_T))) &&
+        (!(v6 & 1) || mbim_ip_field_fits(info->IPv6AddressOffset, length, sizeof(MBIM_IPV6_ELEMENT_T))) &&
