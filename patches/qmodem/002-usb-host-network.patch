+        (!(v6 & 2) || mbim_ip_field_fits(info->IPv6GatewayOffset, length, 16)) &&
+        (!(v4 & 4) || mbim_ip_field_fits(info->IPv4DnsServerOffset, length, dns4)) &&
+        (!(v6 & 4) || mbim_ip_field_fits(info->IPv6DnsServerOffset, length, dns6));
