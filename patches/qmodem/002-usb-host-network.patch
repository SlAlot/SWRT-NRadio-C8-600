+set_if_device()
+{
+    local name="$1" device="$2" protocol="$3"
+    if [ "$(uci -q get "network.$name.device")" = "$device" ] &&
+       [ "$(uci -q get "network.$name.ifname")" = "$device" ] &&
+       [ "$(uci -q get "network.$name.metric")" = "$metric" ] &&
+       [ "$(uci -q get "network.$name.proto")" = "$protocol" ]; then
+        return 0
+    fi
+    uci set "network.$name.device=$device"
+    uci set "network.$name.ifname=$device"
+    uci set "network.$name.modem_config=$modem_config"
+    uci set "network.$name.proto=$protocol"
+    uci set "network.$name.metric=$metric"
+    interface_update_flag=1
+    m_debug "set interface $name to $device ($protocol)"
